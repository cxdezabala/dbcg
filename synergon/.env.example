# PostgreSQL (docker compose up starts it with these credentials)
DATABASE_URL="postgresql://synergon:synergon@localhost:5432/synergon?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# Demo mode: enables the demo-role switcher, scenario shortcuts and "Reset demo data"
DEMO_MODE=true
# Password for the 4 demo users (javier / laura / daniel / omar @asterion.example)
DEMO_PASSWORD="synergon-demo"

# SYNERGON AI — leave empty to use the deterministic fallback (synergon-ai.js ported to TypeScript)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Microsoft Entra ID SSO (prepared, disabled unless all three are set)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
