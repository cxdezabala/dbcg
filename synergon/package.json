{
  "name": "synergon",
  "version": "0.1.0",
  "private": true,
  "description": "SYNERGON MVP — commercial intelligence platform (fictional demo organisation: Asterion Business Solutions)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.66.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
